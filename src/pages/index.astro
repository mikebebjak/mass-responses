---
import "../styles/global.css";
const enterHref = "/mass";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
  
    <title>Catholic Mass Responses in Multiple Languages | For Travelers</title>
    <meta
      name="description"
      content="Catholic Mass responses in multiple languages for travelers. Compare responses side by side in English, Latin, Italian, French, Spanish, German and more!"
    />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/lipis/flag-icons@7.3.2/css/flag-icons.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&display=swap" rel="stylesheet">

  </head>

  <body class="bg-white text-slate-600">
    <main class="mx-auto max-w-2xl px-4 py-10 space-y-8">
      <div class="mr-topbar-right">
        <a
          class="rounded-xl border border-slate-300 px-4 py-3 font-semibold shadow-sm inline-flex items-center gap-2"
          href="https://github.com/mikebebjak/mass-responses"
          target="_blank"
          rel="noopener"
        >
        <svg
          viewBox="0 0 24 24"
          class="h-4 w-4"
          aria-hidden="true"
          fill="currentColor">
          <path d="M12 .5C5.37.5 0 5.87 0 12.5c0 5.29 3.438 9.773 8.205 11.363.6.11.82-.26.82-.577
          0-.285-.01-1.04-.016-2.04-3.338.726-4.042-1.61-4.042-1.61-.546-1.387-1.333-1.757-1.333-1.757
          -1.09-.745.083-.73.083-.73 1.205.085 1.84 1.238 1.84 1.238
          1.07 1.835 2.807 1.305 3.492.998
          .108-.776.418-1.305.762-1.605
          -2.665-.304-5.467-1.332-5.467-5.93
          0-1.31.468-2.38 1.235-3.22
          -.124-.303-.535-1.523.117-3.176
          0 0 1.008-.322 3.3 1.23
          .957-.266 1.983-.399 3.003-.404
          1.02.005 2.047.138 3.006.404
          2.29-1.552 3.296-1.23 3.296-1.23
          .653 1.653.242 2.873.118 3.176
          .77.84 1.233 1.91 1.233 3.22
          0 4.61-2.807 5.624-5.48 5.92
          .43.372.823 1.103.823 2.222
          0 1.606-.015 2.898-.015 3.293
          0 .32.216.694.825.576
          C20.565 22.27 24 17.79 24 12.5
          24 5.87 18.627.5 12 .5z"/>
        </svg>
        GitHub
        </a>
        
        <a class="rounded-xl border border-slate-300 px-4 py-3 font-semibold shadow-sm" href="https://buymeacoffee.com/mikebebs" target="_blank" rel="noopener">
        Donate
        </a>
      </div>

      <h1 class="text-3xl font-semibold leading-tight text-center">Catholic Mass Responses for Travelers</h1>

      <p class="mr-text">
        Traveling to another country and struggling to follow the Catholic Mass? This site provides clear, mobile-friendly, multilingual Catholic Mass responses so travelers can actively participate in the liturgy anywhere in the world. Includes side-by-side translations for all available languages.
      </p>

      <p class="mr-text">Available languages:</p>

      <div class="flag-carousel">
        <div class="flag-track" id="flagTrack">
          <a class="flag-item" href="/mass?lang=en-EN" aria-label="English" title="English">
            <span class="flag-chip fib fi-gb"></span>
            <span class="flag-label"><span class="sr-only">Mass responses in </span>English</span>
          </a>

          <a class="flag-item" href="/mass?lang=la-LA" aria-label="Latin" title="Latin">
            <span class="flag-chip fib fi-va"></span>
            <span class="flag-label"><span class="sr-only">Mass responses in </span>Latin</span>
          </a>

          <a class="flag-item" href="/mass?lang=it-IT" aria-label="Italian" title="Italian">
            <span class="flag-chip fib fi-it"></span>
            <span class="flag-label"><span class="sr-only">Mass responses in </span>Italian</span>
          </a>

          <a class="flag-item" href="/mass?lang=fr-FR" aria-label="French" title="French">
            <span class="flag-chip fib fi-fr"></span>
            <span class="flag-label"><span class="sr-only">Mass responses in </span>French</span>
          </a>

          <a class="flag-item" href="/mass?lang=es-ES" aria-label="Spanish" title="Spanish">
            <span class="flag-chip fib fi-es"></span>
            <span class="flag-label"><span class="sr-only">Mass responses in </span>Spanish</span>
          </a>

          <a class="flag-item" href="/mass?lang=de-DE" aria-label="German" title="German">
            <span class="flag-chip fib fi-de"></span>
            <span class="flag-label"><span class="sr-only">Mass responses in </span>German</span>
          </a>

          <a class="flag-item" href="/mass?lang=sk-SK" aria-label="Slovak" title="Slovak">
            <span class="flag-chip fib fi-sk"></span>
            <span class="flag-label"><span class="sr-only">Mass responses in </span>Slovak</span>
          </a>

          <a class="flag-item" href="/mass?lang=cz-CZ" aria-label="Czech" title="Czech">
            <span class="flag-chip fib fi-cz"></span>
            <span class="flag-label"><span class="sr-only">Mass responses in </span>Czech</span>
          </a>
        </div>
      </div>

      <div class="mt-8 overflow-hidden rounded-2xl">
        <a href={enterHref}
          class="inline-flex w-full max-w-full items-center justify-center bg-slate-900 px-5 py-4 text-lg font-semibold text-white shadow-sm">
          Enter
        </a>
      </div>

      <p class="mr-secondary">
        Note: Vernacular liturgical texts are the property of their respective rights holders.
        Texts here are NOT OFFICIAL and are provided for personal devotional and educational use only. Please <a href="mailto:michaelbebjak@gmail.com">contact us</a> with any questions. 
      </p>

      {/* SEO-only content (hidden, no UX impact) */}
      <div class="sr-only" aria-hidden="true">
        <h2>Catholic Mass Responses</h2>
        <p>
          Mobile-optimized Catholic Mass responses in multiple languages for travelers and worshippers. Side-by-side translations available in multiple languages.
        </p>
        <ul>
          <li>Catholic Mass responses in English</li>
          <li>Catholic Mass responses in Latin</li>
          <li>Catholic Mass responses in Italian</li>
          <li>Catholic Mass responses in French</li>
          <li>Catholic Mass responses in Spanish</li>
          <li>Catholic Mass responses in German</li>
          <li>Catholic Mass responses in Slovak</li>
          <li>Catholic Mass responses in Czech</li>
        </ul>
      </div>
    </main>
  </body>
</html>

<script>
  function highlightActiveFlag(lang) {
    document.querySelectorAll(".flag-chip").forEach(f =>
      f.classList.toggle("active", f.dataset.lang === lang)
    );
  }
</script>

{/* enable horizontal scrolling on the flag carousel when the mouse cursor is over it on desktop */}
<script>
  const track = document.getElementById("flagTrack");

  if (track) {
    track.addEventListener(
      "wheel",
      (e) => {
        const canScrollX = track.scrollWidth > track.clientWidth;
        if (!canScrollX) return;

        const atStart = track.scrollLeft === 0;
        const atEnd =
          Math.ceil(track.scrollLeft + track.clientWidth) >= track.scrollWidth;

        const scrollingDown = e.deltaY > 0;
        const scrollingUp = e.deltaY < 0;

        // Allow normal page scroll ONLY if carousel can't scroll further
        if ((scrollingUp && atStart) || (scrollingDown && atEnd)) {
          return;
        }

        e.preventDefault();
        track.scrollLeft += e.deltaY;
      },
      { passive: false }
    );
  }
</script>